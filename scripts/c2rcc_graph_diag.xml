<?xml version="1.0" encoding="UTF-8"?>
<!--
  DIAGNOSTIC C2RCC graph — identical processing to scripts/c2rcc_graph.xml but
  clipped to a small window around one station BEFORE correction, so it runs in
  CI's memory/time budget. Its OUTPUT VARIABLE STRUCTURE is the same as the full
  graph's, which is the point: the ac-probe workflow runs this to reveal the
  exact rho_w band/variable names, so open_corrected() in notebook 03 can be
  written against real output rather than guesses.

  NOT for production numbers — the Subset makes it a structure probe only.

      gpt scripts/c2rcc_graph_diag.xml -Pinput=<scene.SAFE> -Poutput=<out.nc> \
          -Psalinity=20 -Ptemperature=12

  Region: a ~0.05 deg box around Vlissingen (3.5656 E, 51.4120 N).
-->
<graph id="c2rcc_msi_diag">
  <version>1.0</version>

  <node id="read">
    <operator>Read</operator>
    <parameters>
      <file>${input}</file>
    </parameters>
  </node>

  <node id="subset">
    <operator>Subset</operator>
    <sources>
      <sourceProduct refid="read"/>
    </sources>
    <parameters>
      <geoRegion>POLYGON((3.54 51.39, 3.60 51.39, 3.60 51.43, 3.54 51.43, 3.54 51.39))</geoRegion>
      <copyMetadata>true</copyMetadata>
    </parameters>
  </node>

  <node id="c2rcc">
    <operator>c2rcc.msi</operator>
    <sources>
      <sourceProduct refid="subset"/>
    </sources>
    <parameters>
      <salinity>${salinity}</salinity>
      <temperature>${temperature}</temperature>
      <outputAsRrs>false</outputAsRrs>
      <outputRhown>true</outputRhown>
    </parameters>
  </node>

  <node id="write">
    <operator>Write</operator>
    <sources>
      <sourceProduct refid="c2rcc"/>
    </sources>
    <parameters>
      <file>${output}</file>
      <formatName>NetCDF4-CF</formatName>
    </parameters>
  </node>
</graph>
